      "id": "nserver-label",
      "label": "Central Server",
      "type": "server",
      "size": "medium"
    },
    {
      "id": "nreceive-box",
      "label": "Receive {μ sem (k) , σ² sem (k) } from K clients",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "nbayesian-box",
      "label": "nbayesian-box",
      "type": "service",
      "size": "xl"
    },
    {
      "id": "nbayesian-label",
      "label": "Bayesian Fusion (Precision-Weighted)",
      "type": "service",
      "size": "xl"
    },
    {
      "id": "nbayesian-formula",
      "label": "μ* = Σ k (μ k /σ² k ) / Σ k (1/σ² k ) σ²* = 1 / Σ k (1/σ² k )",
      "type": "service",
      "size": "xl"
    },
    {
      "id": "nbayesian-props",
      "label": "• Clients with lower variance → higher weight • Fused σ²* ≤ min_k σ²_k (uncertainty reduces)",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "nema-box",
      "label": "nema-box",
      "type": "service",
      "size": "xl"
    },
    {
      "id": "nema-label",
      "label": "EMA Momentum",
      "type": "service",
      "size": "medium"
    },
    {
      "id": "nema-formula",
      "label": "G t = β·G t-1 + (1-β)·G t new β = 0.9 (separate EMA on μ and log σ²)",
      "type": "formula",
      "size": "xl"
    },
    {
      "id": "nglobal-proto-box",
      "label": "nglobal-proto-box",
      "type": "service",
      "size": "xl"
    },
    {
      "id": "nglobal-proto-label",
      "label": "Global Prototypes (per class c)",
      "type": "service",
      "size": "xl"
    },
    {
      "id": "nglobal-proto-content",
      "label": "G[c] = N(μ g,c , σ² g,c ) 14-class dictionary (ChestX-ray14) Semantic subspace only (192-dim) Updated each round after EMA smoothing",
      "type": "formula",
      "size": "xl"
    },
    {
      "id": "nwarmup-box",
      "label": "nwarmup-box",
      "type": "service",
      "size": "xl"
    },
    {
      "id": "nwarmup-label",
      "label": "Adaptive λ Warmup",
      "type": "service",
      "size": "medium"
    },
    {
      "id": "nwarmup-formula",
      "label": "λ eff (t) = λ · min(1, (t+1)/W) W = 50 rounds (linear warmup from 0 to λ)",
      "type": "service",
      "size": "xl"
    },
    {
      "id": "nprivacy-acct-box",
      "label": "nprivacy-acct-box",
      "type": "service",
      "size": "xl"
    },
    {
      "id": "nprivacy-acct-label",
      "label": "RDP Privacy Accounting (optional)",
      "type": "service",
      "size": "xl"
    },
    {
      "id": "nprivacy-acct-formula",
      "label": "ε = min λ>1 [T·λ/(2σ²) - log δ/(λ-1)] Moments Accountant across T rounds",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "ninference-panel",
      "label": "ninference-panel",
      "type": "service",
      "size": "xl"
    },
    {
      "id": "ninference-label",
      "label": "Inference (Temperature-Scaled Prototype Classification)",
      "type": "service",
      "size": "xl"
    },
    {
      "id": "ninf-step1",
      "label": "1. Extract Prototype p = fc1(ResNet50(x_test))",
      "type": "input",
      "size": "large"
    },
    {
      "id": "ninf-step2",
      "label": "2. Compute Distance dist(p, G[c]) = ½ Σ_j (p_j-μ_{g,j})²/σ²_{g,j} (Mahalanobis-like for distributional)",
      "type": "formula",
      "size": "xl"
    },
    {
      "id": "ninf-step3",
      "label": "3. Temperature Scaling logit_c(x) = -dist(p, G[c]) / T",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "ninf-step4",
      "label": "4. Predict ŷ_c = σ(logit_c) > 0.5",
      "type": "document",
      "size": "large"
    },
    {
      "id": "ntemp-note",
      "label": "T 1: softer (calibrated)",
      "type": "service",
      "size": "xl"
    },

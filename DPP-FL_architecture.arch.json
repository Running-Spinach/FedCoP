    },
    {
      "id": "nprotohead-sem",
      "label": "ProbabilisticProtoHead μ sem , log σ² sem",
      "type": "document",
      "size": "large"
    },
    {
      "id": "nprotohead-style",
      "label": "ProbabilisticProtoHead μ style , log σ² style",
      "type": "document",
      "size": "medium"
    },
    {
      "id": "nhsic-box",
      "label": "L dis = ||Cov(z sem , z style )||² F HSIC Independence Constraint (computed locally)",
      "type": "formula",
      "size": "xl"
    },
    {
      "id": "ncls-box",
      "label": "fc2 : Concat[z sem , z style ] → 14-dim logits",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "nloss-box",
      "label": "Local Loss: L = L BCE + λ eff ·L proto sem + λ dis ·L dis",
      "type": "loss",
      "size": "xl"
    },
    {
      "id": "ndp-box",
      "label": "Differential Privacy (optional) L2 Clip(C) + N(0, σ²C²I) → (μ sem || logσ² sem )",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "nwithin-agg-box",
      "label": "Within-Client Aggregation μ_avg = mean(μ_i) σ²_avg = mean(σ²_i) + Var(μ_i)",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "ncomm-container",
      "label": "ncomm-container",
      "type": "service",
      "size": "large"
    },

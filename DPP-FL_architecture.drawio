        <mxCell id="warmup-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=1;fontColor=#884422;fontFamily=Times New Roman;" value="&lt;b&gt;Adaptive λ Warmup&lt;/b&gt;" vertex="1">
          <mxGeometry height="18" width="150" x="640" y="538" as="geometry" />

        <mxCell id="inf-step2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#555555;strokeWidth=1;fontSize=9;fontFamily=Times New Roman;" value="&lt;b&gt;2. Compute Distance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8pt&quot;&gt;dist(p, G[c]) = ½ Σ_j (p_j-μ_{g,j})²/σ²_{g,j}&lt;br&gt;(Mahalanobis-like for distributional)&lt;/font&gt;" vertex="1">
